<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.JoathiVA.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/surface_spacing">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topToolbar"
            style="@style/Widget.JoathiVA.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            app:subtitle="@string/app_subtitle"
            app:title="@string/app_name"
            app:titleCentered="false" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.JoathiVA.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/surface_spacing">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/webview_background">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/webview_background" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressIndicator"
                    style="@style/Widget.JoathiVA.LinearProgressIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="5" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.JoathiVA.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonHome"
                style="@style/Widget.JoathiVA.BottomNavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/nav_home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCrm"
                style="@style/Widget.JoathiVA.BottomNavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/nav_crm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonQuote"
                style="@style/Widget.JoathiVA.BottomNavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/nav_quote" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAgenda"
                style="@style/Widget.JoathiVA.BottomNavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/nav_agenda" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
