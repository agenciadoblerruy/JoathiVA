# Joathi Outlook Assistant - configuracion local
# Copiar a config/assistant.local.env si queres ajustar rutas o modo.
# No guardar credenciales reales en Git.

JOATHI_ASSISTANT_MODE=files
JOATHI_INPUT_DIR=./input/emails
JOATHI_OUTPUT_DIR=./output
JOATHI_RULES_FILE=./config/assistant.rules.json
JOATHI_GRAPH_FOLDER=Inbox
JOATHI_GRAPH_LIMIT=25
JOATHI_APPLY_TO_OUTLOOK=false

# Aplicar movimientos reales a las carpetas de Outlook solo cuando ya revisaste la salida.
JOATHI_APPLY_MOVES=false
