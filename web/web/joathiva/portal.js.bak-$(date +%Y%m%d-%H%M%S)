    return modalShell("Preview cliente Agente 5", `
      <div class="agent5-preview">
        <div class="agent5-preview-head">
          <strong>${preview.quoteCode}</strong>
          ${badge(quote.status)}
        </div>
        ${details([
          ["Cliente", preview.client],
          ["Ruta", preview.route],
          ["Servicio", preview.service],
          ["Carga", preview.cargoType],
          ["Unidades", preview.units],
          ["Precio visible", money(preview.finalPrice, preview.currency)],
          ["Vigencia", preview.validUntil]
