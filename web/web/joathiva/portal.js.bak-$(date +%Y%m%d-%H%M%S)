      <form class="modal-form" data-track-form>
        <label>Ubicación actual<input name="location" value="${track.location || ""}" required></label>
        <label>Estado de viaje<input name="state" value="${track.state || ""}" required></label>
        <label>Progreso demo<input type="number" name="progress" min="0" max="100" value="${track.progress ?? 0}" required></label>
