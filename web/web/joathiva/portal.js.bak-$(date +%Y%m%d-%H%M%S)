function agent6BuildDraft(operation) {
  if (!operation) return null;
  return agent6Draft({
    id: `${operation.id}-REENVIO-001`,
    operationId: operation.id,
    status: "BORRADOR_PREPARADO",
    recipient: operation.suggestedRecipient,
    subject: operation.resendTemplate.subject,
    body: operation.resendTemplate.body,
    includedDocs: operation.resendTemplate.includedDocs,
    approvalRequired: true,
    history: [`${stamp()}: borrador preparado para ${operation.id}.`]
  });
}

function agent6SelectOperation(operationId) {
  const operation = agent6OperationById(operationId);
  if (!operation) return;
  agent6State.selectedOperationId = operationId;
  agent6State.history.unshift(`${stamp()}: seleccionada la operación ${operationId}.`);
  saveAgent6();
  showToast(`Operacion ${operationId} seleccionada.`);
}

function agent6SetDocStatus(operationId, docId, status) {
  const operation = agent6OperationById(operationId);
  if (!operation) return;
  const doc = operation.docs.find((item) => item.id === docId);
  if (!doc) return;
  if (doc.status === status) {
    showToast(`El documento ${doc.name} ya estaba en ${status}.`);
    return;
  }
  doc.status = status;
  doc.history.unshift(`${stamp()}: estado actualizado a ${status}.`);
  operation.history.unshift(`${stamp()}: documento ${doc.name} actualizado a ${status}.`);
  agent6State.history.unshift(`${stamp()}: ${operationId} · ${doc.name} pasó a ${status}.`);
  agent6State.selectedOperationId = operationId;
  saveAgent6();
  showToast(`Documento ${doc.name} actualizado.`);
}

function agent6PrepareResend(operationId) {
  const operation = agent6OperationById(operationId);
  if (!operation) return;
  const draft = agent6BuildDraft(operation);
  draft.status = "BORRADOR_PREPARADO";
  draft.history.unshift(`${stamp()}: borrador preparado desde la operación ${operationId}.`);
  operation.resend = draft;
  operation.history.unshift(`${stamp()}: borrador de reenvío preparado.`);
  agent6State.history.unshift(`${stamp()}: preparado reenvío para ${operationId}.`);
  agent6State.selectedOperationId = operationId;
  saveAgent6();
  showToast(`Reenvío preparado para ${operationId}.`);
}

function agent6SetDraftStatus(operationId, status) {
  const operation = agent6OperationById(operationId);
  if (!operation) return;
  if (!operation.resend) operation.resend = agent6BuildDraft(operation);
  const draft = operation.resend;
  draft.status = status;
  draft.history.unshift(`${stamp()}: estado actualizado a ${status}.`);
  operation.history.unshift(`${stamp()}: reenvío ${status}.`);
  agent6State.history.unshift(`${stamp()}: ${operationId} reenvío ${status}.`);
  agent6State.selectedOperationId = operationId;
  saveAgent6();
  showToast(`Reenvío ${status.toLowerCase().replaceAll("_", " ")}.`);
}

function agent6AddObservation(form) {
  const data = new FormData(form);
  const text = String(data.get("observation") || "").trim();
  if (!text) return;
  const context = modal?.target || "";
  const operationId = modal?.operationId;
  if (!operationId) return;
  const operation = agent6OperationById(operationId);
  if (!operation) return;
  if (context === "doc") {
    const doc = operation.docs.find((item) => item.id === modal.docId);
    if (!doc) return;
    doc.observations.push(`${stamp()}: ${text}`);
    doc.history.unshift(`${stamp()}: observación agregada.`);
    operation.history.unshift(`${stamp()}: observación documental en ${doc.name}.`);
    agent6State.history.unshift(`${stamp()}: observación agregada a ${operationId} / ${doc.name}.`);
  } else {
    if (!operation.resend) operation.resend = agent6BuildDraft(operation);
    operation.resend.observations.push(`${stamp()}: ${text}`);
    operation.resend.history.unshift(`${stamp()}: observación agregada.`);
    operation.history.unshift(`${stamp()}: observación agregada al reenvío.`);
    agent6State.history.unshift(`${stamp()}: observación agregada al reenvío de ${operationId}.`);
  }
  modal = null;
  saveAgent6();
  showToast("Observacion documental guardada.");
}

