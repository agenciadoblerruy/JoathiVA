function ensureAgent6State(state) {
  const seed = initialAgent6State();
  if (!state || typeof state !== "object") return seed;
  const operations = seed.operations.map((seedOperation) => {
    const existing = Array.isArray(state.operations) ? state.operations.find((item) => item.id === seedOperation.id) : null;
    if (!existing) return seedOperation;
    const docs = seedOperation.docs.map((seedDoc) => {
      const current = Array.isArray(existing.docs) ? existing.docs.find((doc) => doc.id === seedDoc.id || doc.name === seedDoc.name) : null;
      if (!current) return seedDoc;
      return {
        ...seedDoc,
        ...current,
        history: Array.isArray(current.history) && current.history.length ? current.history : seedDoc.history,
        observations: Array.isArray(current.observations) ? current.observations : []
      };
    });
    const resend = existing.resend ? {
      ...seedOperation.resend,
      ...existing.resend,
      history: Array.isArray(existing.resend.history) && existing.resend.history.length ? existing.resend.history : seedOperation.resend?.history || [],
      observations: Array.isArray(existing.resend.observations) ? existing.resend.observations : []
    } : seedOperation.resend;
    return {
      ...seedOperation,
      ...existing,
      docs,
      resend,
      history: Array.isArray(existing.history) && existing.history.length ? existing.history : seedOperation.history
    };
  });
  const selectedOperationId = state.selectedOperationId && operations.some((item) => item.id === state.selectedOperationId)
    ? state.selectedOperationId
    : seed.selectedOperationId;
  return {
    selectedOperationId,
    filters: {
      operation: state.filters?.operation || "",
      type: state.filters?.type || "",
      status: state.filters?.status || ""
    },
    operations,
    history: Array.isArray(state.history) && state.history.length ? state.history : seed.history,
    lastUpdated: state.lastUpdated || seed.lastUpdated
  };
}

