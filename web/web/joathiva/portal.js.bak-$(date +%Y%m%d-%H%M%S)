function modalShell(title, content) {
  return `<div class="web-modal"><div class="web-modal-card"><h2>${title}</h2>${content}</div></div>`;
}

function toastMarkup() {
  return toast ? `<div class="web-toast">${toast}</div>` : "";
}

function showToast(message) {
  toast = message;
  render();
  setTimeout(() => {
    toast = "";
    render();
  }, 1800);
}

