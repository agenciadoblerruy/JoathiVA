function agent5UpdateStatus(id, status) {
  const quote = findAgent5Quote(id);
  if (!quote) return;
  quote.status = status;
  quote.version += 1;
  quote.versions.unshift({
    version: quote.version,
    status,
    reason: `Cambio manual a ${status}`,
    createdAt: stamp()
  });
  quote.history.unshift(`${stamp()}: estado actualizado a ${status}.`);
  agent5State.history.unshift(`${stamp()}: ${id} cambió a ${status}.`);
  agent5State.activeQuoteId = id;
  saveAgent5();
  showToast(`Cotizacion ${id} actualizada a ${status}.`);
}

function agent5Duplicate(id) {
  const quote = findAgent5Quote(id);
  if (!quote) return;
  const copyIndex = agent5State.quotes.length + 1;
  const nextId = `CQ-COPY-${String(copyIndex).padStart(3, "0")}`;
  const duplicate = {
    ...quote,
    id: nextId,
    status: "BORRADOR",
    version: 1,
    history: [`${stamp()}: duplicada desde ${id}.`],
    versions: [{ version: 1, status: "BORRADOR", reason: `Duplicada desde ${id}`, createdAt: stamp() }]
  };
  agent5State.quotes.unshift(duplicate);
  agent5State.activeQuoteId = nextId;
  agent5State.history.unshift(`${stamp()}: ${id} duplicada como ${nextId}.`);
  saveAgent5();
  showToast("Version duplicada.");
  render();
}

