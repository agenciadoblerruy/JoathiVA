function agent6OperationStatus(operation) {
  if (!operation) return "RECIBIDO";
  const statuses = operation.docs.map((doc) => doc.status);
  if (operation.resend?.status === "ENVIADO_MANUALMENTE") return "DOCUMENTACION_COMPLETA";
  if (statuses.some((status) => status === "OBSERVADO")) return "OBSERVADO";
  if (statuses.some((status) => status === "DRAFT_RECIBIDO")) return "DRAFT_RECIBIDO";
  if (statuses.some((status) => status === "PENDIENTE_SALIDA")) return "PENDIENTE_SALIDA";
  if (statuses.some((status) => status === "EN_TRANSITO")) return "EN_TRANSITO";
  if (statuses.some((status) => status === "ARRIBADO")) return "ARRIBADO";
  if (statuses.some((status) => status === "PENDIENTE_REVISION")) return "PENDIENTE_REVISION";
  if (statuses.some((status) => status === "REENVIO_PREPARADO")) return "REENVIO_PREPARADO";
  if (statuses.some((status) => status === "LISTO_PARA_REENVIAR")) return "LISTO_PARA_REENVIAR";
  if (statuses.some((status) => status === "CORREGIDO")) return "CORREGIDO";
  if (statuses.every((status) => ["APROBADO", "CLASIFICADO", "RECIBIDO", "ENVIADO_MANUALMENTE", "DOCUMENTACION_COMPLETA"].includes(status))) return "DOCUMENTACION_COMPLETA";
  if (statuses.some((status) => status === "APROBADO")) return "APROBADO";
  if (statuses.some((status) => status === "CLASIFICADO")) return "CLASIFICADO";
  return operation.status || "RECIBIDO";
}

function agent6ResendStatus(operation) {
  return operation?.resend?.status || "SIN_BORRADOR";
}

