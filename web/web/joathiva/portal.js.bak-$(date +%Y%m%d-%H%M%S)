        <span><strong>ETA</strong>${operation.eta}</span>
        <span><strong>Actualizado</strong>${data.updatedAt}</span>
      </div>
      <div class="route-progress"><span style="width:${progress}%"></span></div>
      <small>${data.state} · ${progress}%</small>
    </article>
  `;
}

function trackingData(operation) {
  const progress = operation.tracking?.progress ?? progressByStatus(operation.status);
  return {
    origin: operation.tracking?.origin || shortPlace(operation.origin),
    destination: operation.tracking?.destination || shortPlace(operation.destination),
    location: operation.tracking?.location || currentPlaceByStatus(operation),
    updatedAt: operation.tracking?.updatedAt || stamp(),
    driver: operation.tracking?.driver || operation.driver || "Pendiente",
    state: operation.tracking?.state || stateText(operation.status),
    note: operation.tracking?.note || "",
    progress
  };
}

function progressByStatus(status) {
  if (status === "CREADA") return 0;
  if (status === "COORDINACION_CARGA") return 10;
  if (status === "EN_RUTA") return 50;
  if (status === "EN_FRONTERA") return 70;
  if (status === "CARGA_ENTREGADA") return 100;
  if (status === "DEMORADA") return 45;
  return 0;
}

function stateText(status) {
  if (status === "CREADA") return "Pendiente de coordinacion";
  if (status === "COORDINACION_CARGA") return "Pendiente de coordinacion";
  if (status === "EN_RUTA") return "En ruta";
  if (status === "EN_FRONTERA") return "En frontera";
  if (status === "CARGA_ENTREGADA") return "Entregado";
  if (status === "DEMORADA") return "Demorada";
  return labelState(status);
}

function currentPlaceByStatus(operation) {
  if (operation.status === "CARGA_ENTREGADA") return shortPlace(operation.destination);
  if (operation.status === "CREADA") return "Pendiente";
  return shortPlace(operation.origin);
}

function shortPlace(value = "") {
  return String(value).split(",")[0].trim() || "Pendiente";
}

function clampProgress(value) {
  const numeric = Number(value);
  if (Number.isNaN(numeric)) return 0;
  return Math.max(0, Math.min(100, numeric));
}

function operativeOps() {
  return [...sharedState.operations].sort((a, b) => a.id.localeCompare(b.id));
