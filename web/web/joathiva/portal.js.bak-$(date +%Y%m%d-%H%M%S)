function agent1AddForm() {
  return `
    <form class="form-grid compact" data-agent1-add-form>
      <input name="company_name" placeholder="Empresa *" required>
      <input name="industry" placeholder="Rubro (ej. importacion)">
      <input name="country" placeholder="Pais">
      <input name="city" placeholder="Ciudad">
      <input name="email" placeholder="Email">
      <input name="phone" placeholder="Telefono">
      <input name="website" placeholder="Web">
      <input name="company_size" placeholder="Tamano (pequena/mediana/grande)">
      <input name="lead_source" placeholder="Fuente (referido/web/evento/frio)">
      <input name="route_interest" placeholder="Ruta de interes">
      <input name="cargo_type" placeholder="Tipo de carga">
      <input name="estimated_frequency" placeholder="Frecuencia (mensual/semanal...)">
      <button class="btn btn-primary" type="submit">Registrar y puntuar</button>
    </form>
    <p class="readonly-note">Alta local. El score y la prioridad se calculan automaticamente. No se contacta a nadie.</p>
  `;
}

function agent1Action(id, action) {
  const p = agent1Find(id);
  if (!p) return;
  const now = stamp();
  if (action === "score") {
    p.commercial_fit_score = agent1Score(p);
    p.priority = agent1Priority(p.commercial_fit_score);
    p.commercial_fit_label = agent1Label(p.commercial_fit_score);
    p.last_scored_at = now;
    const draft = agent1Draft(p);
    p.draft_subject = draft.subject;
    p.draft_message = draft.message;
    p.contact_draft = draft.message;
    p.history.unshift(`${now}: score recalculado a ${p.commercial_fit_score} (prioridad ${p.priority}).`);
    agent1State.history.unshift(`${now}: ${p.company_name} re-puntuado (${p.commercial_fit_score}).`);
    showToast(`Score actualizado: ${p.commercial_fit_score} (${p.priority}).`);
  } else if (action === "draft") {
    const draft = agent1Draft(p);
    p.draft_subject = draft.subject;
    p.draft_message = draft.message;
    p.contact_draft = draft.message;
    p.history.unshift(`${now}: borrador interno regenerado.`);
    agent1State.history.unshift(`${now}: ${p.company_name} borrador regenerado.`);
    showToast("Borrador interno regenerado.");
  } else {
    const map = { qualify: "CALIFICADO", followup: "SEGUIMIENTO", convert: "CONVERTIDO", discard: "DESCARTADO" };
    const status = map[action];
    if (!status) return;
    p.status = status;
    if (status === "CONVERTIDO" || status === "DESCARTADO") { p.next_action = ""; p.next_action_due_at = ""; }
    if (status === "SEGUIMIENTO" && !p.next_action_due_at) p.next_action_due_at = addDays(3);
    p.last_contact_at = now;
    p.history.unshift(`${now}: estado -> ${status}.`);
    agent1State.history.unshift(`${now}: ${p.company_name} -> ${status}.`);
    showToast(`${p.company_name}: ${labelState(status)}.`);
  }
  agent1State.selectedId = id;
  saveAgent1();
}

function agent1AddProspect(form) {
  const data = Object.fromEntries(new FormData(form).entries());
  const name = String(data.company_name || "").trim();
  if (!name) return;
  const seq = String(agent1State.prospects.length + 1).padStart(4, "0");
  const id = `PRJ-${seq}`;
  const prospect = agent1Prospect({ ...data, id, source: "MANUAL_DEMO", external_id: id });
  agent1State.prospects.unshift(prospect);
  agent1State.selectedId = id;
  agent1State.history.unshift(`${stamp()}: alta manual ${prospect.company_name} (score ${prospect.commercial_fit_score}).`);
  saveAgent1();
  showToast(`Prospecto ${prospect.company_name} registrado (${prospect.priority}).`);
}

function agent1AddNote(form) {
  const text = String(new FormData(form).get("note") || "").trim();
  const p = agent1Find(modal.id);
  if (p && text) {
    const now = stamp();
    p.commercial_notes = text;
    p.history.unshift(`${now}: nota - ${text}`);
    agent1State.history.unshift(`${now}: nota en ${p.company_name}.`);
  }
  modal = null;
  saveAgent1();
  showToast("Nota guardada.");
}

