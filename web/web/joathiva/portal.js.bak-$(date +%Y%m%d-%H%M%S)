function ensureSharedData(state) {
  const demo = initialSharedState();
  demo.quotes.forEach((demoQuote) => {
    const existing = state.quotes.find((item) => item.id === demoQuote.id);
    if (!existing) state.quotes.push(demoQuote);
  });
  demo.operations.forEach((demoOperation) => {
    if (!state.operations.find((item) => item.id === demoOperation.id)) state.operations.push(demoOperation);
  });
  ensureOperativeOperations(state);
}

