    if (existing) {
      Object.keys(demo).forEach((key) => {
        if (existing[key] === undefined || existing[key] === "") existing[key] = demo[key];
      });
      existing.tracking = (existing.tracking || {}).manualUpdated
        ? { ...demo.tracking, ...existing.tracking }
        : { ...(existing.tracking || {}), ...demo.tracking };
      existing.history = existing.history || demo.history;
      existing.observations = existing.observations || [];
    } else {
      state.operations.push(demo);
    }
  });
}

