        <div class="modal-actions"><button type="button" data-close>Cancelar</button><button type="submit">Actualizar</button></div>
      </form>
    `);
  }
  if (modal.type === "confirmDelivery") {
    return modalShell("Confirmar entrega", `<p class="readonly-note">¿Confirmar entrega y notificar a Administración para facturación?</p><div class="modal-actions"><button type="button" data-close>Cancelar</button><button type="button" data-confirm-delivery="${modal.id}">Confirmar</button></div>`);
  }
  if (modal.type === "agent6DocDetail") {
    return agent6DocDetail(modal.operationId, modal.docId);
  }
  if (modal.type === "docDetail") {
    const doc = opDocsState[modal.operationId]?.[modal.index];
    return modalShell("Detalle documental", `<div class="chat-demo"><p><strong>${modal.operationId} · ${doc?.name}</strong></p><p>Estado: ${doc ? badge(doc.status) : ""}</p><p>Observaciones: ${(doc?.observations || []).join(" / ") || "Sin observaciones"}</p><button data-close>Cerrar</button></div>`);
