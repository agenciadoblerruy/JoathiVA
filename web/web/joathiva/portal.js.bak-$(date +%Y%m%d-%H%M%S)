  return `
    <article class="route-visual ${size}${alertClass}${deliveredClass}${originClass}">
      <div class="route-header">
        <div><span class="record-id">${operation.id}</span><strong>${operation.client}</strong></div>
        ${badge(operation.status)}
      </div>
      <div class="route-canvas" aria-label="Mapa visual simulado de ${operation.id}">
        <svg viewBox="0 0 320 150" role="img" aria-label="Ruta ${data.origin} a ${data.destination}">
          <defs>
            <linearGradient id="route-bg-${operation.id}" x1="0" x2="1">
              <stop offset="0%" stop-color="#f8fbf4"></stop>
              <stop offset="100%" stop-color="#eaf3ef"></stop>
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="320" height="150" rx="14" fill="url(#route-bg-${operation.id})"></rect>
          <path d="M36 118 C84 40, 124 118, 168 72 S248 32, 286 92" fill="none" stroke="#d7e2dc" stroke-width="26" stroke-linecap="round"></path>
          <path d="M36 118 C84 40, 124 118, 168 72 S248 32, 286 92" fill="none" stroke="#ffffff" stroke-width="18" stroke-linecap="round" stroke-dasharray="5 12"></path>
          <line x1="28" y1="116" x2="292" y2="86" stroke="#0E3B2E" stroke-width="5" stroke-linecap="round" opacity=".28"></line>
          <line x1="28" y1="116" x2="${currentX}" y2="${116 - (progress * 0.3)}" stroke="${operation.status === "DEMORADA" ? "#c0392b" : "#F2B200"}" stroke-width="6" stroke-linecap="round"></line>
          <circle class="route-dot origin" cx="28" cy="116" r="8"></circle>
          <circle class="route-dot current" cx="${currentX}" cy="${116 - (progress * 0.3)}" r="10"></circle>
          <circle class="route-dot destination" cx="292" cy="86" r="8"></circle>
          <text x="28" y="138">${data.origin}</text>
          <text x="${Math.max(54, Math.min(236, currentX - 28))}" y="${Math.max(26, 104 - (progress * 0.3))}">${data.location}</text>
          <text x="214" y="72">${data.destination}</text>
