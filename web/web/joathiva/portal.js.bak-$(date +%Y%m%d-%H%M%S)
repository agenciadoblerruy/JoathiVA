root.addEventListener("submit", (event) => {
  event.preventDefault();
  const form = event.target;
  if (form.hasAttribute("data-respond-form")) return respondQuote(form);
  if (form.hasAttribute("data-observe-form")) return addObservation(form);
  if (form.hasAttribute("data-follow-form")) return createFollow(form);
  if (form.hasAttribute("data-task-form")) return createTask(form);
  if (form.hasAttribute("data-postsale-form")) return addPostSale(form);
  if (form.hasAttribute("data-task-observe-form")) return addTaskObservation(form);
  if (form.hasAttribute("data-op-status-form")) return updateOperationStatus(form);
  if (form.hasAttribute("data-assign-form")) return assignOperation(form);
