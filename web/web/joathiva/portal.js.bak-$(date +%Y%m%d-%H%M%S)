        <h3>Lineas visibles</h3>
        <ul class="agent5-list">
          ${preview.visibleLineItems.map((item) => `<li>${item.direction} · ${item.description} · ${item.units} un. · ${money(item.visiblePriceTotal, preview.currency)}</li>`).join("")}
