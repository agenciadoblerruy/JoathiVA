function agent6VisibleDocs() {
  return agent6AllDocs().filter(({ operation, doc }) => {
    if (agent6State.filters.operation && operation.id !== agent6State.filters.operation) return false;
    if (agent6State.filters.type && doc.type !== agent6State.filters.type) return false;
    if (agent6State.filters.status && doc.status !== agent6State.filters.status) return false;
    return true;
