    return modalShell("Asignacion bloqueada", `<p class="readonly-note">No se puede asignar. El proveedor, chofer o vehículo no cumple con la documentación obligatoria vigente.</p><div class="modal-actions"><button type="button" data-close>Cerrar</button><button type="button" data-view-pending>Ver documentación pendiente</button></div>`);
