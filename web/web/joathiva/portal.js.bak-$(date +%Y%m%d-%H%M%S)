  if (modal.type === "docObserve") {
    return modalShell("Agregar observación documental", `
      <form class="modal-form" data-doc-observe-form>
        <label>Observacion<textarea name="observation" rows="5" required></textarea></label>
        <div class="modal-actions"><button type="button" data-close>Cancelar</button><button type="submit">Guardar</button></div>
      </form>
    `);
  }
  if (modal.type === "incident") {
    return modalShell("Crear incidencia", `
      <form class="modal-form" data-incident-form>
        <label>Operacion<select name="operationId">${operativeOps().map((op) => `<option value="${op.id}">${op.id} · ${op.client}</option>`).join("")}</select></label>
