function agent6Timeline() {
  const items = [
    ...agent6State.history.map((entry) => `Agente 6: ${entry}`),
    ...agent6State.operations.flatMap((operation) => [
      ...operation.history.map((entry) => `${operation.id}: ${entry}`),
