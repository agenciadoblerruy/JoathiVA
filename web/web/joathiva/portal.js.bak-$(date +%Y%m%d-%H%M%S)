function agent1Score(p) {
  let s = 0;
  const ind = (p.industry || "").toLowerCase();
  if (/(import|export|comercio exterior|aduana|logist)/.test(ind)) s += 26;
  else if (/(manufactura|industria|agro|automotriz|retail|aliment|quimic|frigor)/.test(ind)) s += 18;
  else s += 8;
  if (p.route_interest) s += 12;
  if (p.cargo_type) s += 10;
  if (p.estimated_volume) s += 8;
  const freq = (p.estimated_frequency || "").toLowerCase();
  if (/(semanal|mensual|recurrente|quincenal)/.test(freq)) s += 12; else if (freq) s += 6;
  const size = (p.company_size || "").toLowerCase();
  if (/(grande|corporativ|\+?200|500)/.test(size)) s += 14; else if (/(median|50|100)/.test(size)) s += 9; else if (size) s += 4;
  const src = (p.lead_source || "").toLowerCase();
  if (/(referido|referral)/.test(src)) s += 12; else if (/(evento|feria)/.test(src)) s += 10; else if (/(web|inbound)/.test(src)) s += 8; else if (src) s += 4;
  if (p.email) s += 4;
  if (p.phone) s += 4;
  if (p.website) s += 3;
  if (p.city) s += 2;
  return Math.max(0, Math.min(100, Math.round(s)));
}

function agent1Priority(score) {
  if (score >= 70) return "A";
  if (score >= 45) return "B";
  return "C";
}

function agent1Label(score) {
  if (score >= 70) return "Alta prioridad";
  if (score >= 45) return "Prioridad media";
  return "Prioridad baja";
}

