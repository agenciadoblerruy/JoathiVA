function ensureOpDocs(operationId) {
  const current = opDocsState[operationId] || [];
  opDocsState[operationId] = REQUIRED_OPERATION_DOCS.map((name) => current.find((doc) => doc.name === name) || {
    id: `${operationId}-${name.toUpperCase()}`,
    operationId,
    name,
    type: name,
    status: "PENDIENTE",
    observations: [],
    history: [`${stamp()}: ${name} inicializado.`]
  });
}

function documentSummary(operationId) {
  ensureOpDocs(operationId);
  const valid = opDocsState[operationId].filter((doc) => doc.status === "VALIDADO").length;
  return `${valid}/${REQUIRED_OPERATION_DOCS.length} validados`;
}

