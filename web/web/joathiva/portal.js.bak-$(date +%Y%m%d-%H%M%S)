  if (form.hasAttribute("data-agent6-observe-form")) return agent6AddObservation(form);
  if (form.hasAttribute("data-agent1-add-form")) return agent1AddProspect(form);
  if (form.hasAttribute("data-agent1-note-form")) return agent1AddNote(form);
});

function markReview(id) {
  const item = findQuote(id);
  if (!item) return;
  item.status = "EN_REVISION";
  item.updatedAt = today();
  item.history.push(`${stamp()}: Ejecutivo Comercial marco la cotizacion en revision.`);
  commercialState.history.unshift(`${stamp()}: ${id} paso a EN_REVISION.`);
  saveShared();
  saveCommercial();
  showToast("Cotizacion marcada en revision.");
}

function respondQuote(form) {
  const item = findQuote(modal.id);
  const data = new FormData(form);
  const price = String(data.get("formalPrice") || "").trim();
  if (!price) {
    document.getElementById("modal-error").textContent = "El precio formal es obligatorio.";
    return;
  }
  item.status = "RESPONDIDA";
  item.formalPrice = price;
  item.commercialTerms = data.get("commercialTerms") || "";
  item.updatedAt = today();
  const note = data.get("observation");
  if (note) item.commercialObservations.push(`${stamp()}: Ejecutivo Comercial - ${note}`);
  item.history.push(`${stamp()}: cotizacion respondida con precio formal ${price}.`);
  commercialState.history.unshift(`${stamp()}: ${item.id} respondida. El cliente podra aprobar o cancelar.`);
  modal = null;
  saveShared();
  saveCommercial();
  showToast("Cotizacion respondida. El cliente podra aprobar o cancelar.");
}

function addObservation(form) {
  const item = findQuote(modal.id);
  const text = new FormData(form).get("observation");
  item.commercialObservations.push(`${stamp()}: Ejecutivo Comercial - ${text}`);
  item.history.push(`${stamp()}: observacion comercial agregada.`);
  commercialState.history.unshift(`${stamp()}: observacion comercial en ${item.id}.`);
  modal = null;
  saveShared();
  saveCommercial();
  showToast("Observacion guardada.");
}

function createFollow(form) {
  const item = findQuote(modal.id);
  const data = new FormData(form);
  const id = `COM-T${String(commercialState.nextTaskNumber++).padStart(3, "0")}`;
  commercialState.tasks.unshift(task(id, `Seguimiento ${item.id}`, item.company, item.id, data.get("dueDate"), "PENDIENTE", data.get("note") || "Seguimiento comercial."));
  item.history.push(`${stamp()}: seguimiento creado para ${data.get("dueDate")}.`);
  commercialState.history.unshift(`${stamp()}: seguimiento ${id} creado para ${item.id}.`);
  modal = null;
  saveShared();
  saveCommercial();
  showToast("Seguimiento creado.");
}

function createTask(form) {
  const data = new FormData(form);
  const id = `COM-T${String(commercialState.nextTaskNumber++).padStart(3, "0")}`;
  commercialState.tasks.unshift(task(id, data.get("title"), data.get("client"), data.get("quoteId"), data.get("dueDate"), "PENDIENTE", data.get("note") || ""));
  commercialState.history.unshift(`${stamp()}: tarea ${id} creada.`);
  modal = null;
  saveCommercial();
  showToast("Tarea creada.");
}

function addPostSale(form) {
  const text = new FormData(form).get("note");
  commercialState.postSaleNotes.unshift({ operationId: modal.id, note: text, createdAt: stamp() });
  commercialState.history.unshift(`${stamp()}: nota posventa agregada para ${modal.id}.`);
  modal = null;
  saveCommercial();
  showToast("Nota posventa guardada.");
}

function addTaskObservation(form) {
  const item = commercialState.tasks.find((taskItem) => taskItem.id === modal.id);
  if (!item) return;
  const text = new FormData(form).get("observation");
  item.observations.push(`${stamp()}: Ejecutivo Comercial - ${text}`);
  item.history.push(`${stamp()}: observacion agregada.`);
  commercialState.history.unshift(`${stamp()}: observacion en tarea ${item.id}.`);
  modal = null;
  saveCommercial();
  showToast("Observacion de tarea guardada.");
}

function setTaskStatus(id, status) {
  const item = commercialState.tasks.find((taskItem) => taskItem.id === id);
  if (!item) return;
  item.status = status;
  item.history.push(`${stamp()}: estado actualizado a ${status}.`);
  commercialState.history.unshift(`${stamp()}: tarea ${id} actualizada a ${status}.`);
  saveCommercial();
  showToast("Tarea actualizada.");
}

function cancelQuote(id) {
  const item = findQuote(id);
  if (!item) return;
  item.status = "CANCELADA";
  item.updatedAt = today();
  item.history.push(`${stamp()}: cotizacion cancelada en modo demo.`);
  commercialState.history.unshift(`${stamp()}: ${id} cancelada.`);
  saveShared();
  saveCommercial();
  showToast("Cotizacion cancelada.");
}

function acceptQuote(id) {
  const item = findQuote(id);
  if (!item) return;
  item.status = "APROBADA";
  item.updatedAt = today();
  let operation = operationForQuote(id);
  if (!operation) {
    const opId = `OP-${String(sharedState.nextOperationNumber++).padStart(4, "0")}`;
    operation = { id: opId, quoteId: id, client: item.company, origin: item.originAddress, destination: item.destinationAddress, status: "COORDINACION_CARGA", carrier: "Pendiente", eta: "A confirmar", deliveredAt: "", satisfaction: "Pendiente", history: [`${stamp()}: operacion creada desde ${id}.`] };
    sharedState.operations.unshift(operation);
  }
  item.operationId = operation.id;
  item.history.push(`${stamp()}: cliente aprobo la cotizacion. Operacion ${operation.id} creada.`);
  saveShared();
  showToast("Cotizacion aprobada. Comercial la vera como APROBADA.");
}

function openContact(payload) {
  const [id, channel] = payload.split(":");
  const item = findQuote(id) || { company: "Cliente", email: "contacto@importacionessa.com", phone: "+598 99 000 001" };
  commercialState.history.unshift(`${stamp()}: contacto ${channel} preparado para ${item.company}.`);
  saveCommercial();
  if (channel === "chat") {
    modal = { type: "chat", client: item.company };
    render();
    return;
  }
  if (channel === "email") window.location.href = `mailto:${item.email}?subject=Seguimiento%20JoathiVA`;
  if (channel === "whatsapp") window.location.href = `https://wa.me/${item.phone.replace(/[^0-9]/g, "")}`;
  if (channel === "call") window.location.href = `tel:${item.phone.replaceAll(" ", "")}`;
}

function openDirectContact(payload) {
  const [rawName, value, channel] = payload.split("|");
  const name = decodeURIComponent(rawName);
  opHistoryState.unshift(`${stamp()}: contacto ${channel} preparado para ${name}.`);
  saveOperational();
