        <label>Severidad<select name="severity">${INCIDENT_SEVERITIES.map((severity) => `<option value="${severity}">${severity}</option>`).join("")}</select></label>
        <label>Descripcion<textarea name="description" rows="4" required></textarea></label>
        <div class="modal-actions"><button type="button" data-close>Cancelar</button><button type="submit">Crear</button></div>
      </form>
    `);
  }
  if (modal.type === "incidentObserve") {
    return modalShell("Observacion de incidencia", `
      <form class="modal-form" data-incident-observe-form>
        <label>Observacion<textarea name="observation" rows="5" required></textarea></label>
        <div class="modal-actions"><button type="button" data-close>Cancelar</button><button type="submit">Guardar</button></div>
      </form>
    `);
  }
  if (modal.type === "dispatch") {
    const op = findOperation(modal.id);
    return modalShell("Actualizar despacho", `
      <form class="modal-form" data-dispatch-form>
        <label>Despachante<input name="broker" value="${op?.customsBroker || ""}" required></label>
        <label>Estado despacho<input name="status" value="${op?.customsStatus || ""}" required></label>
        <label>Observacion<textarea name="observation" rows="4"></textarea></label>
        <div class="modal-actions"><button type="button" data-close>Cancelar</button><button type="submit">Actualizar</button></div>
