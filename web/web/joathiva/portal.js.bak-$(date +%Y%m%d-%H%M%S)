        </section>
        <aside class="web-panel">
          ${agent1Detail(p)}
        </aside>
      </div>
      ${panel("Alta manual de prospecto", agent1AddForm())}
      ${panel("Historial del Agente 1", notes(agent1State.history))}
    </section>
  `;
}

function agent1Table(list) {
  if (!list.length) return empty("Sin prospectos con el filtro actual.");
  return `
    <table class="data-table">
      <thead><tr><th>Empresa</th><th>Rubro</th><th>Ruta</th><th>Score</th><th>Prioridad</th><th>Estado</th><th>Proxima accion</th><th>Acciones</th></tr></thead>
      <tbody>${list.map((p) => `
        <tr class="${p.id === agent1State.selectedId ? "row-highlight" : ""}">
          <td>${p.company_name}</td>
          <td>${p.industry}</td>
          <td>${p.route_interest || "-"}</td>
          <td><strong>${p.commercial_fit_score}</strong></td>
          <td><span class="badge badge-${p.priority}">${p.priority}</span></td>
          <td>${badge(p.status)}</td>
          <td>${p.next_action ? `${p.next_action}${agent1IsOverdue(p) ? ' <span class="badge badge-DESCARTADO">vencida</span>' : ""}` : "Sin definir"}</td>
          <td class="table-actions">
            <button data-agent1-select="${p.id}">Ver</button>
            <button data-agent1-action="${p.id}:score">Recalcular</button>
            <button data-agent1-action="${p.id}:qualify">Calificar</button>
            <button data-agent1-action="${p.id}:followup">Seguimiento</button>
            <button data-agent1-action="${p.id}:convert">Convertir</button>
            <button data-agent1-action="${p.id}:discard">Descartar</button>
          </td>
        </tr>
      `).join("")}</tbody>
    </table>
  `;
}

function agent1Detail(p) {
  if (!p) return empty("Selecciona un prospecto.");
  return `
    <div class="detail-heading">
      <div>
        <span class="record-id">${p.id}</span>
        <h3>${p.company_name}</h3>
        <p class="meta">${p.industry}${p.country ? ` · ${p.country}` : ""}${p.city ? `, ${p.city}` : ""}</p>
      </div>
      <span class="badge badge-${p.priority}">${p.priority}</span>
    </div>
    ${details([
      ["Score comercial", `${p.commercial_fit_score} / 100 · ${p.commercial_fit_label}`],
      ["Estado", badge(p.status)],
      ["Ruta de interes", p.route_interest || "-"],
      ["Carga", `${p.cargo_type || "-"}${p.estimated_volume ? ` · ${p.estimated_volume}` : ""}${p.estimated_frequency ? ` · ${p.estimated_frequency}` : ""}`],
      ["Tamano", p.company_size || "-"],
      ["Fuente", `${p.lead_source || "-"}${p.source_detail ? ` · ${p.source_detail}` : ""}`],
      ["Contacto", `${p.email || "-"}${p.phone ? ` · ${p.phone}` : ""}${p.website ? ` · ${p.website}` : ""}`],
      ["Proxima accion", `${p.next_action || "Sin definir"}${p.next_action_due_at ? ` (${p.next_action_due_at})` : ""}`],
      ["Ultimo score", p.last_scored_at || "-"]
    ])}
    ${p.commercial_notes ? `<p class="obs">Nota: ${p.commercial_notes}</p>` : ""}
    <h4>Borrador interno (no se envia)</h4>
    <p class="meta"><strong>${p.draft_subject}</strong></p>
    <pre class="agent1-body">${p.draft_message}</pre>
    <div class="detail-actions">
      <button data-agent1-action="${p.id}:score">Recalcular score</button>
      <button data-agent1-action="${p.id}:draft">Regenerar borrador</button>
      <button data-agent1-action="${p.id}:qualify">Calificar</button>
      <button data-agent1-action="${p.id}:followup">Seguimiento</button>
      <button data-agent1-action="${p.id}:convert">Convertir</button>
      <button data-agent1-action="${p.id}:discard">Descartar</button>
