  if (form.hasAttribute("data-doc-observe-form")) return addDocumentObservation(form);
  if (form.hasAttribute("data-incident-form")) return createIncident(form);
  if (form.hasAttribute("data-incident-observe-form")) return addIncidentObservation(form);
